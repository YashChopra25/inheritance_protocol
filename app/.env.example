# =============================================================================
# Vault Inheritance — environment template
# =============================================================================
#
# Copy this file to `.env` (or `.env.local` for `next dev`) and fill in real
# values. This file holds PLACEHOLDERS ONLY — never commit real secrets.
#
#   [REQUIRED]  the app refuses to start / sign-in or uploads fail without it
#   [OPTIONAL]  has a safe default; the default is stated on each variable
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# BUILD time: everyone can read them, and changing one needs a rebuild. Never
# put a secret or an API key in a NEXT_PUBLIC_ variable.
#
# NODE_ENV is not listed: Next.js sets it (`development` for `npm run dev`,
# `production` for `npm run build` / `npm start`).


# -----------------------------------------------------------------------------
# 1. Solana network (public — read by browser AND server)
# -----------------------------------------------------------------------------

# [REQUIRED] Address of the deployed vault-inheritance program.
# Must match `declare_id!` in programs/vault-inheritance/src/lib.rs and
# [programs.<cluster>] in Anchor.toml. No default: the app throws at startup
# rather than silently talking to the wrong program.
NEXT_PUBLIC_PROGRAM_ID=YourProgramId1111111111111111111111111111111

# [OPTIONAL] Cluster label: devnet | testnet | mainnet-beta | localnet.
# Default: devnet. Drives explorer links and the "Devnet" badge, and must agree
# with NEXT_PUBLIC_RPC_ENDPOINT (checked at startup — a mismatch is an error).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# [OPTIONAL] RPC endpoint the BROWSER uses (wallet transactions, dashboard
# reads). Default: https://api.devnet.solana.com.
# Public by definition — if you use a paid provider, use a key restricted to
# your domain, never an unrestricted one. The public endpoints are rate limited.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com


# -----------------------------------------------------------------------------
# 2. Server secrets (never sent to the browser)
# -----------------------------------------------------------------------------

# [REQUIRED] HMAC key that signs sign-in challenges and session cookies.
# At least 32 characters. Generate with:  openssl rand -base64 48
# Changing it signs every user out. Leaking it lets anyone forge a session.
SESSION_SECRET=replace-with-at-least-32-random-characters

# [REQUIRED] Pinata API JWT, used server-side to pin, list, rename, unpin and
# fetch the encrypted document containers. Create one in the Pinata dashboard
# (API Keys) with Files read/write access.
PINATA_JWT_TOKEN=your-pinata-jwt

# [REQUIRED] Your Pinata dedicated gateway domain (no https://), used to build
# short-lived signed links for reading private files.
PINATA_GATEWAY=your-gateway.mypinata.cloud


# -----------------------------------------------------------------------------
# 3. Server options (strongly recommended in production)
# -----------------------------------------------------------------------------

# [OPTIONAL — set in production] Public origin of the site, e.g.
# https://vault.example.com. It is written into every sign-in message
# (Sign-In-With-Solana domain + URI), so wallets can warn users about phishing
# sites. Default: derived from the request's Host header (fine locally).
# If it doesn't match the real site address, wallets warn on every sign-in.
# APP_ORIGIN=https://vault.example.com

# [OPTIONAL] Server-only RPC for access checks (getAccountInfo /
# getProgramAccounts). Use a private endpoint here — it can safely hold an API
# key because it never reaches the browser. Must be on the same cluster.
# Default: NEXT_PUBLIC_RPC_ENDPOINT. Also used by scripts/death-watch.mjs.
# SOLANA_RPC_URL=https://your-private-rpc.example.com/?api-key=your-key

# [OPTIONAL] Upstash Redis (REST) for shared state: rate limits, upload quotas,
# used sign-in nonces and logged-out sessions. Set BOTH or neither.
# Default: in-process memory — resets on restart and is not shared between
# instances (a warning is logged in production). Required if you run more than
# one server instance.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# [OPTIONAL] Set to `true` ONLY when a reverse proxy (nginx, Cloudflare, …)
# overwrites X-Forwarded-For / X-Forwarded-Host / X-Forwarded-Proto. Enables
# per-IP rate limits and trusts the forwarded host for sign-in.
# Default: false (forwarded headers ignored — clients could spoof them).
# TRUST_PROXY_HEADERS=false

# [OPTIONAL] Total upload budget across ALL wallets per rolling hour, in bytes.
# The backstop on your Pinata bill. Default: 2147483648 (2 GB).
# (Per-file limit 25 MB and per-wallet 200 MB/hour are fixed in code.)
# MAX_UPLOAD_BYTES_GLOBAL_PER_HOUR=2147483648


# -----------------------------------------------------------------------------
# 4. Scripts only (not read by the web app)
# -----------------------------------------------------------------------------

# [OPTIONAL] scripts/death-watch.mjs (`npm run watch:deaths`): Slack/Discord or
# any JSON webhook that receives an alert when custodians start confirming a
# will owner's death. Default: alerts are printed to the terminal.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# [OPTIONAL] scripts/death-watch.mjs: file that remembers which alerts were
# already sent, so each one is sent once. Default: .death-watch-state.json
# DEATH_WATCH_STATE=.death-watch-state.json

# [OPTIONAL] scripts/devnet-smoke.mjs (`npm run smoke:devnet`): keypair that
# pays for the smoke test. Default: ~/.config/solana/id.json
# SOLANA_KEYPAIR=/path/to/keypair.json


# -----------------------------------------------------------------------------
# 5. Deprecated
# -----------------------------------------------------------------------------

# [UNUSED] No code reads this any more (documents are fetched server-side
# through PINATA_GATEWAY). Safe to delete from your .env and CI secrets.
# NEXT_PUBLIC_PINATA_GATEWAY=your-gateway.mypinata.cloud
